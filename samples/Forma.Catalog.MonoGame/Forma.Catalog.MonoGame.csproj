<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>Forma.Catalog.MonoGame</AssemblyName>
    <RootNamespace>Forma.Catalog</RootNamespace>
    <UseAppHost>false</UseAppHost>
    <IsPackable>false</IsPackable>
    <Nullable>disable</Nullable>
    <CatalogBackend Condition="'$(CatalogBackend)' == ''">$(MonoGamePlatform)</CatalogBackend>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Content.Builder.Task" Version="$(MonoGameVersion)" />
    <PackageReference Include="$(MonoGamePackageId)" Version="$(MonoGameVersion)" Condition="'$(MonoGameProjectPath)' == ''" />
    <ProjectReference Include="$(MonoGameProjectPath)" Condition="'$(MonoGameProjectPath)' != ''" />
    <PackageReference Include="MonoGame.Runtime.Linux.Vulkan" Version="$(MonoGameVersion)" Condition="'$(MonoGamePlatform)' == 'Native' And '$(NativeRuntimePath)' == '' And $([MSBuild]::IsOSPlatform('Linux'))" />
    <PackageReference Include="MonoGame.Runtime.Mac.Vulkan" Version="$(MonoGameVersion)" Condition="'$(MonoGamePlatform)' == 'Native' And '$(NativeRuntimePath)' == '' And $([MSBuild]::IsOSPlatform('OSX'))" />
    <ProjectReference Include="../Forma.Catalog/Forma.Catalog.csproj" AdditionalProperties="FormaRuntime=MonoGame;CatalogBackend=$(CatalogBackend)" />
    <Compile Include="../Forma.Catalog/Program.cs" Link="Program.cs" />
    <MonoGameContentReference Include="../Forma.Catalog/Content/Content.mgcb" />
    <Content Include="$(NativeRuntimePath)" Link="$([System.IO.Path]::GetFileName('$(NativeRuntimePath)'))" CopyToOutputDirectory="PreserveNewest" Condition="'$(MonoGamePlatform)' == 'Native' And '$(NativeRuntimePath)' != ''" />
    <None Include="../../LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../NOTICE.md" Link="NOTICE.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../tests/Assets/Fonts/LICENSE.Inter.txt" Link="Content/Fonts/LICENSE.Inter.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../tests/Assets/Fonts/LICENSE.JetBrainsMono.txt" Link="Content/Fonts/LICENSE.JetBrainsMono.txt" CopyToOutputDirectory="PreserveNewest" />
    <AssemblyMetadata Include="FormaCatalogBackend" Value="$(CatalogBackend)" />
  </ItemGroup>

  <Target Name="UseVulkanContentForNativeCatalog" BeforeTargets="CollectContentReferences" Condition="'$(MonoGamePlatform)' == 'Native'">
    <PropertyGroup>
      <_FormaCatalogRuntimePlatform>$(MonoGamePlatform)</_FormaCatalogRuntimePlatform>
      <MonoGamePlatform>DesktopVK</MonoGamePlatform>
    </PropertyGroup>
  </Target>

  <Target Name="RestoreNativeCatalogPlatform" AfterTargets="IncludeContent" Condition="'$(_FormaCatalogRuntimePlatform)' != ''">
    <PropertyGroup>
      <MonoGamePlatform>$(_FormaCatalogRuntimePlatform)</MonoGamePlatform>
    </PropertyGroup>
  </Target>

</Project>