<BoxContainer
    xmlns="https://forma.dev/xaml"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Forma.Catalog"
    x:Class="Forma.Catalog.IconDiagnosticsStoryView"
    x:DataType="local:CatalogStoryViewModel"
    Separation="10"
    CustomMinimumSize="480,180">
    <Label
        x:Name="status"
        Text="{Binding Status}"
        CustomMinimumSize="480,48" />
    <HBoxContainer Separation="8">
        <Button
            x:Name="one"
            Text="Use 1x"
            CustomMinimumSize="110,34" />
        <Button
            x:Name="two"
            Text="Use 2x"
            CustomMinimumSize="110,34" />
        <Button
            x:Name="refresh"
            Text="Refresh"
            CustomMinimumSize="110,34" />
    </HBoxContainer>
</BoxContainer>
