<Project>
  <PropertyGroup>
    <FormaMediaFnaPackageReferenced>true</FormaMediaFnaPackageReferenced>
  </PropertyGroup>
  <Target Name="ValidateFormaMediaFnaPackageGraph" BeforeTargets="ResolveReferences">
    <Error Condition="'$(FormaMediaMonoGamePackageReferenced)' == 'true'"
           Text="Forma.Media.FNA and Forma.Media.MonoGame cannot be referenced by the same project. Select one Forma media runtime variant." />
    <Error Condition="'$(FormaCoreMonoGamePackageReferenced)' == 'true'"
           Text="Forma.Media.FNA cannot be combined with Forma.MonoGame. Reference Forma.FNA instead." />
  </Target>
</Project>