<Project>
  <PropertyGroup>
    <FormaSvgFnaPackageReferenced>true</FormaSvgFnaPackageReferenced>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)Forma.Svg.PackageInitializer.cs.txt" Link="obj/Forma.Svg.PackageInitializer.cs" Visible="false" />
  </ItemGroup>
  <Target Name="ValidateFormaSvgFnaPackageGraph" BeforeTargets="ResolveReferences">
    <Error Condition="'$(FormaSvgMonoGamePackageReferenced)' == 'true'"
           Text="Forma.Svg.FNA and Forma.Svg.MonoGame cannot be referenced by the same project. Select one Forma runtime variant." />
    <Error Condition="'$(FormaCoreMonoGamePackageReferenced)' == 'true'"
           Text="Forma.Svg.FNA cannot be combined with Forma.MonoGame. Reference Forma.Svg.MonoGame instead." />
  </Target>
</Project>