<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Forma</AssemblyName>
    <RootNamespace>Forma</RootNamespace>
    <PackageId>Forma</PackageId>
    <VersionPrefix>0.1.0-alpha.1</VersionPrefix>
    <Description>Retained-mode UI toolkit for MonoGame.</Description>
    <PackageTags>monogame;ui;game-development</PackageTags>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup Condition="'$(MonoGameProjectPath)' == ''">
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
    <PackageReference Include="$(MonoGamePackageId)" Version="$(MonoGameVersion)" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup Condition="'$(MonoGameProjectPath)' != ''">
    <ProjectReference Include="$(MonoGameProjectPath)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../LICENSE" Pack="true" PackagePath="" />
    <None Include="../../NOTICE.md" Pack="true" PackagePath="" />
    <None Include="../../README.md" Pack="true" PackagePath="" />
    <None Include="../../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="" />
    <None Include="../../docs/migration.md" Pack="true" PackagePath="docs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Forma.Media" />
    <InternalsVisibleTo Include="Forma.RenderTests" />
    <InternalsVisibleTo Include="Forma.Tests" />
  </ItemGroup>

</Project>
