    <AssemblyName>Forma.FnaVideoSmoke</AssemblyName>
    <RootNamespace>Forma.FnaVideoSmoke</RootNamespace>
    <FormaRuntime>FNA</FormaRuntime>
    <IsPackable>false</IsPackable>
