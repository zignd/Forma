  <ItemGroup>
    <PackageReference Include="$(FnaPackageId)" Version="$(FnaVersion)" />
    <ProjectReference Include="../../src/Forma.Media/Forma.Media.csproj" AdditionalProperties="FormaRuntime=FNA" />
  </ItemGroup>

</Project>