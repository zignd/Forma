<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <FormaRuntime Condition="'$(FormaRuntime)' == ''">MonoGame</FormaRuntime>
    <FormaPackageVersion>$(FormaVersion)</FormaPackageVersion>
    <RestoreSources>$(FormaPackageSource);https://api.nuget.org/v3/index.json</RestoreSources>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Forma.Xaml.HotReload.$(FormaRuntime)" Version="$(FormaPackageVersion)" />
  </ItemGroup>
</Project>
